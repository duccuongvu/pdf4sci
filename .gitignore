__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.pytest_cache/

# local test inputs / outputs and any other PDFs dropped in the repo
# root while developing -- never part of the project source
*.pdf

# raw/unprocessed design uploads -- the app only ships the generated
# icons under pdf4sci/assets/icons/
/images/

# planning docs for this session's own instructions, not project source
instruction.md
WEBAPP_GUI_INSTRUCTION.md
GUI_INSTRUCTION.md

/scratch/

# packaging build artifacts and staging trees -- large, regenerated by
# scripts/build_*.sh, never checked in. dist/ and build/ above already
# cover packaging/*/dist and packaging/pyinstaller/build.
/packaging/appimage/AppDir/
/packaging/appimage/squashfs-root/
/packaging/appimage/appimagetool-x86_64.AppImage
/packaging/deb/pdf4sci_*_amd64/

# auto-generated by build_bundle.sh (PyInstaller writes this fresh from
# its CLI flags every run) -- not hand-written source, would just go stale
/packaging/pyinstaller/*.spec
